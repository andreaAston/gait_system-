# Supabase project public credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never add either value to firmware or a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
GAIT_INGEST_TOKEN=generate-a-long-random-gateway-token

$PIO = "$env:USERPROFILE\.platformio\penv\Scripts\platformio.exe"
& $PIO device list

& $PIO run -d ".\firmware\production\left_esp32_gateway" -t upload --upload-port COMx
& $PIO run -d ".\firmware\production\right_esp32_c3_crutch" -t upload --upload-port COMx
& $PIO run -d ".\firmware\production\left_esp8266_fsr" -t upload --upload-port COMx
& $PIO run -d ".\firmware\production\right_esp32_fsr" -t upload --upload-port COMx

& $PIO device monitor -p COMx -b 115200